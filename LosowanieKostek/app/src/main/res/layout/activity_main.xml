<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Tytuł aplikacji: 28sp, bold, wyśrodkowany w poziomie -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Losowanie kostek"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Napis pomocniczy: 18sp, wyrównany do lewej -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liczba kostek:"
            android:textSize="18sp" />

        <!-- Pole tekstowe: hint, inputType number, domyślna wartość 5 -->
        <EditText
            android:id="@+id/editTextLiczbaKostek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Podaj liczbę kostek"
            android:inputType="number"
            android:text="5" />

        <!-- Przycisk LOSUJ -->
        <Button
            android:id="@+id/buttonLosuj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LOSUJ" />

        <!-- Nagłówek sekcji kostek: 20sp, bold, górny margines 20dp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Wylosowane kostki:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Kontener na kostki (na etapie XML pozostaje pusty) -->
        <GridLayout
            android:id="@+id/gridKostki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="1"
            android:gravity="center"
            android:useDefaultMargins="true" />

        <!-- Nagłówek sekcji wyników: 20sp, bold, górny margines 20dp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Wyniki:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Pole na wyniki -->
        <TextView
            android:id="@+id/textViewWyniki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="Wyniki pojawią się tutaj"
            android:textSize="20sp" />

        <!-- Przyciski sortowania, jeden pod drugim -->
        <Button
            android:id="@+id/buttonRosnaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="SORTUJ ROSNĄCO" />

        <Button
            android:id="@+id/buttonMalejaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="SORTUJ MALEJĄCO" />

    </LinearLayout>
</ScrollView>
